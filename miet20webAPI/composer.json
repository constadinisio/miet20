{
    "name": "miet20/legacy-client",
    "type": "project",
    "require": {
        "guzzlehttp/guzzle": "^7.8",
        "monolog/monolog": "^3.4",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "phpstan/phpstan": "^1.11"
    },
    "autoload": {
        "psr-4": {
            "App\\Api\\": "public/includes/api/"
        }
    },
    "scripts": {
        "test": [
            "php tests/ApiClientTest.php"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse"
        ]
    }
}
